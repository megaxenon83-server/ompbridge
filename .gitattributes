# Normalise line endings so Linux build scripts and manifests work in CI.
* text=auto

*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.iss text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.ttf binary
*.jar binary
*.jks binary
*.apk binary
*.exe binary
*.zip binary
