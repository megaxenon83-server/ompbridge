+
+    def test_cancel_stops_the_running_turn_and_keeps_the_page_rule(self):
+        # A stopped client can leave its turn on the model: /v1/cancel releases it, so the next unload is not 409.
+        event = threading.Event()
+        self.svc.active_cancels.add(event)
+        try:
+            code, body = self.request("/v1/cancel", {})
+            self.assertEqual((code, body["status"], body["cancelled"]), (200, "cancelled", 1))
+            self.assertTrue(event.is_set())
+            other = threading.Event()
+            self.svc.active_cancels.add(other)
+            self.assertEqual(self.request("/v1/cancel", {}, {"Origin": "https://other.example"})[0], 403)
+            self.assertFalse(other.is_set())
+        finally:
+            self.svc.active_cancels.discard(event)
+            self.svc.active_cancels.discard(other)
 
